# Optional. Without these the app runs offline and claim links are disabled.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Where the web build is hosted, so claim links open in a browser. Leave blank to use bagged:// deep links.
EXPO_PUBLIC_WEB_URL=
